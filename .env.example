# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: point the online arcade to a separately hosted WebSocket server.
# The Vercel deployment works without this; the local two-player mode is shown.
# VITE_ARENA_WS_URL="wss://arena.example.org/ws"

# Optional, public PostHog project key and ingestion host. Set these in Vercel
# Project Settings > Environment Variables to enable the consent based page views.
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Puck editor at /admin. Set strong, unique values on the server; never use VITE_ prefixes.
ADMIN_PASSWORD="replace-with-a-long-unique-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Required to publish from Vercel. The token needs Contents: Read and write for this repository.
# Local development saves directly into templates/*.json without these settings.
# GITHUB_CONTENT_TOKEN="github_pat_..."
# GITHUB_CONTENT_REPO="owner/pcss-robotics"
# GITHUB_CONTENT_BRANCH="main"
